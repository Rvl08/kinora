# Rust
/target/
**/target/

# JS
node_modules/
dist/
.svelte-kit/
*.tsbuildinfo

# Native dependencies (FFmpeg LGPL build, ONNX Runtime, ...)
/vendor/

# Test media and downloaded models (fetched by script, verified by hash)
/tests/media/
/models/cache/

# Tauri generated schemas
/apps/desktop/src-tauri/gen/
/spikes/*/src-tauri/gen/

# Local and editor files
.env
.env.*
*.log
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Windows Sandbox files generated per machine (host paths, user name)
/spikes/*/sandbox/generated/
/scripts/*/sandbox/generated/
/scripts/sandbox/generated/
/tests/sandbox-out/

# Impeccable (design skill, see .claude/README.md): the platform engine binary is
# downloaded and SHA-256-verified by the launcher; hooks and consent are per machine.
.claude/skills/impeccable/scripts/bin/
.claude/settings.local.json
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/*.ndjson
