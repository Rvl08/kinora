{
  "name": "kinora-workspace",
  "private": true,
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "licenses:check": "node scripts/check-js-licenses.mjs",
    "ui:check": "pnpm --filter @kinora/ui run check",
    "ui:test": "pnpm --filter @kinora/ui run test",
    "ui:build": "pnpm --filter @kinora/ui run build",
    "ffmpeg:fetch": "node scripts/ffmpeg/fetch.mjs",
    "ffmpeg:verify": "node scripts/ffmpeg/verify.mjs",
    "ffmpeg:verify:ship": "node scripts/ffmpeg/verify.mjs --release",
    "ffmpeg:build:release": "node scripts/ffmpeg/release/build.mjs",
    "sign": "node scripts/signing/sign.mjs",
    "sign:verify": "node scripts/signing/verify.mjs",
    "fixtures:fetch": "node scripts/fixtures/fetch.mjs",
    "fixtures:generate": "node scripts/fixtures/generate.mjs",
    "fixtures:verify": "node scripts/fixtures/verify.mjs",
    "ipc:generate": "cargo run -p kinora-ipc --example generate",
    "ipc:check": "cargo test -p kinora-ipc --test contract && cargo test -p kinora-project --test document"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
