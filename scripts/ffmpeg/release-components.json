{
  "$comment": "Draft component set for Kinora's trimmed release FFmpeg (P0-05b). Built with --disable-everything plus these. Names are FFmpeg component names as `ffmpeg -decoders|-encoders|-demuxers|-muxers|-bsfs|-protocols|-filters` print them (configure spells a few with underscores, e.g. libvpx_vp9). Validated by scripts/ffmpeg/check-components.py against the dev build. Rationale per group in docs/spikes/S2-report.md §6.",
  "decoders": {
    "video": [
      "h264",
      "hevc",
      "av1",
      "libdav1d",
      "vp8",
      "vp9",
      "mpeg2video",
      "mpeg4",
      "mjpeg",
      "prores",
      "dnxhd",
      "ffv1",
      "png",
      "gif",
      "webp",
      "bmp",
      "tiff",
      "rawvideo"
    ],
    "audio": [
      "aac",
      "mp3float",
      "mp2float",
      "opus",
      "vorbis",
      "flac",
      "alac",
      "ac3",
      "eac3",
      "pcm_s16le",
      "pcm_s24le",
      "pcm_s32le",
      "pcm_f32le",
      "pcm_s16be",
      "pcm_s24be",
      "pcm_u8"
    ],
    "subtitle": ["subrip", "ass", "webvtt", "mov_text"]
  },
  "encoders": {
    "video": [
      "h264_nvenc",
      "hevc_nvenc",
      "av1_nvenc",
      "h264_qsv",
      "hevc_qsv",
      "av1_qsv",
      "h264_amf",
      "hevc_amf",
      "av1_amf",
      "libsvtav1",
      "libvpx-vp9",
      "prores_ks",
      "dnxhd",
      "png",
      "mjpeg",
      "gif"
    ],
    "audio": ["aac", "libopus", "flac", "pcm_s16le", "pcm_s24le", "libmp3lame"],
    "subtitle": ["mov_text", "subrip", "webvtt"]
  },
  "demuxers": [
    "mov",
    "matroska",
    "avi",
    "mpegts",
    "mpeg",
    "flv",
    "ogg",
    "wav",
    "w64",
    "aiff",
    "mp3",
    "aac",
    "flac",
    "image2",
    "gif",
    "srt",
    "ass",
    "webvtt",
    "h264",
    "hevc"
  ],
  "muxers": [
    "mp4",
    "mov",
    "ipod",
    "matroska",
    "webm",
    "adts",
    "mp3",
    "wav",
    "flac",
    "ogg",
    "opus",
    "gif",
    "image2",
    "srt",
    "webvtt",
    "ass"
  ],
  "bsfs": [
    "h264_mp4toannexb",
    "hevc_mp4toannexb",
    "aac_adtstoasc",
    "extract_extradata",
    "vp9_superframe",
    "h264_metadata",
    "hevc_metadata",
    "null"
  ],
  "protocols": ["file", "pipe"],
  "filters": [
    "buffer",
    "buffersink",
    "abuffer",
    "abuffersink",
    "format",
    "aformat",
    "null",
    "anull",
    "scale",
    "aresample",
    "volume",
    "amix",
    "loudnorm",
    "ebur128",
    "setpts",
    "asetpts",
    "fps",
    "transpose",
    "hflip",
    "vflip",
    "crop",
    "pad",
    "hwdownload",
    "hwupload"
  ],
  "hwaccel_devices": ["d3d11va", "d3d12va", "dxva2", "cuda (nvdec)", "qsv (libvpl)", "amf"],
  "external_libraries": {
    "keep": [
      "libdav1d",
      "libsvtav1",
      "libvpx",
      "libopus",
      "libmp3lame",
      "libvpl",
      "ffnvcodec",
      "amf",
      "zlib"
    ],
    "optional_decide_in_phase_1": [
      "libwebp (WebP export)",
      "libjxl (JPEG XL import)",
      "libzimg (HDR tone mapping, zscale)"
    ],
    "drop": [
      "libaom",
      "librav1e",
      "libkvazaar",
      "libvvenc",
      "libopenh264 (Cisco DLL at run time instead)",
      "libzvbi (GPL-2.0+)",
      "libplacebo",
      "libshaderc",
      "librsvg",
      "libxml2",
      "libzmq",
      "libssh",
      "librist",
      "libsrt",
      "libbluray",
      "libgme",
      "libopenmpt",
      "libaribb24",
      "libaribcaption",
      "libopencore-amrnb",
      "libopencore-amrwb",
      "libtwolame",
      "libtheora",
      "libuavs3d",
      "liblcevc-dec",
      "liboapv",
      "libsnappy",
      "libass",
      "libfreetype",
      "libfribidi",
      "libharfbuzz",
      "libvmaf",
      "libsoxr",
      "libvorbis (native decoder kept)",
      "libopenjpeg"
    ]
  }
