  "implicit": {
    "$comment": "Components configure enables on its own because a listed one selects them (`*_select` in FFmpeg's configure). Allowed in the build but never requested; the release gate fails on any other extra, so a version bump that pulls in something new is reviewed here first. Entries found by the first complete CI build (run 40060533206): h263 via the mpeg4 decoder, pgs_frame_merge and vp9_superframe_split via the listed Matroska/MP4 and VP9 components.",
    "decoders": ["h263"],
    "bsfs": ["pgs_frame_merge", "vp9_superframe_split"]
  }
